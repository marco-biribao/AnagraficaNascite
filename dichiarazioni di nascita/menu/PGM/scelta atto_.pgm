READ 'C:\Myepi\dichiarazioni di nascita\DICHIARAZIONE_NASCITA.MDB':TEMP

list

DEFINE SCELTA TEXTINPUT

DIALOG "scegli l'operazione da effettuare" SCELTA "1 USCIRE DAL PROGRAMMA","2 STAMPA MODELLO A","3 STAMPA MODELLO A1","4 STAMPA MODELLO B","5 STAMPA MODELLO B1","6 STAMPA MODELLO C","7 STAMPA MODELLO C1","8 STAMPA MODELLO D","9 STAMPA MODELLO D1","10 STAMPA MODELLO A_madre","11 STAMPA MODELLO A1_madre"TITLETEXT="STAMPA DICHIARAZIONE DI NASCITA"


IF SCELTA= "1 USCIRE DAL PROGRAMMA"  THEN
      QUIT
END
IF SCELTA= "2 STAMPA MODELLO A"  THEN
      RUNPGM 'C:\Myepi\dichiarazioni di nascita\PGM\Modello_A.PGM'
END
IF SCELTA= "3 STAMPA MODELLO A1"  THEN
      RUNPGM 'C:\Myepi\dichiarazioni di nascita\PGM\Modello_A1.PGM'
END
IF SCELTA= "4 STAMPA MODELLO B"  THEN
      RUNPGM 'C:\Myepi\dichiarazioni di nascita\PGM\Modello_B.PGM'
END
IF SCELTA= "5 STAMPA MODELLO B1"  THEN
      RUNPGM 'C:\Myepi\dichiarazioni di nascita\PGM\Modello_B1.PGM'
END
IF SCELTA= "6 STAMPA MODELLO C"  THEN
      RUNPGM 'C:\Myepi\dichiarazioni di nascita\PGM\Modello_C.PGM'
END
IF SCELTA= "7 STAMPA MODELLO C1"  THEN
      RUNPGM 'C:\Myepi\dichiarazioni di nascita\PGM\Modello_C1.PGM'
END
IF SCELTA= "8 STAMPA MODELLO D"  THEN
      RUNPGM 'C:\Myepi\dichiarazioni di nascita\PGM\Modello_D.PGM'
END
IF SCELTA= "9 STAMPA MODELLO D1"  THEN
       RUNPGM 'C:\Myepi\dichiarazioni di nascita\PGM\Modello_D1.PGM'
END
IF SCELTA= "10 STAMPA MODELLO A_madre"  THEN
       RUNPGM 'C:\Myepi\dichiarazioni di nascita\PGM\Modello_A_madre.PGM'
END
IF SCELTA= "11 STAMPA MODELLO A1_madre"  THEN
       RUNPGM 'C:\Myepi\dichiarazioni di nascita\PGM\Modello_A1_madre.PGM'
END








