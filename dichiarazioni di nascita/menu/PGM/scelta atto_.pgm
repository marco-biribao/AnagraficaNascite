*** programma di stampa atto dichiarazione di nascita 

*leggiamo la view

READ 'C:\Myepi\dichiarazioni di nascita\DICHIARAZIONE_NASCITA.MDB':viewDICHIARAZIONENASCITA
 
** creiamo la finestra di dialogo per la scelta dell'atto

DEFINE CERCA
DIALOG "CERCA LA DATA DELLA DICHIARAZIONE DI NASCITA DA STAMPARE E DAI OK" CERCA DBVALUES  DICHIARAZIONENASCITA DATAATTO TITLETEXT="RICERCA PER DATA ATTO"

DEFINE CERCA2
ASSIGN CERCA2=txttodate(CERCA)
define cerca3

IF dataATTO=CERCA2 THEN 
ASSIGN CERCA3="a"
END

SELECT CERCA3="a"

WRITE REPLACE "Epi 2000" 'C:\Myepi\dichiarazioni di nascita\DICHIARAZIONE_NASCITA.MDB':TEMP * 

READ 'C:\Myepi\dichiarazioni di nascita\DICHIARAZIONE_NASCITA.MDB':TEMP

define cerca5

DIALOG "CERCA IL NUMERO DELLA DICHIARAZIONE DI NASCITA DA STAMPARE E DAI OK" cerca5 DBVALUES  TEMP NUMATTO TITLETEXT="RICERCA PER NUMERO ATTO"
define cerca6
define cerca7
ASSIGN cerca6=txttonum(cerca5)
IF numATTO=CERCA6 THEN 
ASSIGN CERCA7="b"
END

SELECT cerca7="b"

