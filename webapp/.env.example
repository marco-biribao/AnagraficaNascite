APP_NAME="Anagrafica Nascite"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=it
APP_FALLBACK_LOCALE=it
APP_FAKER_LOCALE=it_IT

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=anagrafica_nascite
DB_USERNAME=anagrafica
DB_PASSWORD=

# Account amministratore locale di emergenza (auth_source=local), usato solo
# se Active Directory non e' raggiungibile. Cambiare la password all'atto
# del primo deploy.
ADMIN_USERNAME=admin.locale
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Connessione al controller di dominio Active Directory. LDAP_USERNAME e'
# l'account di servizio (sola lettura sulla directory) usato per cercare gli
# utenti; il bind con la password dell'utente che effettua il login avviene
# a parte, per ogni tentativo di accesso.
LDAP_HOST=
LDAP_PORT=389
LDAP_USERNAME=
LDAP_PASSWORD=
LDAP_BASE_DN=
LDAP_USERNAME_ATTRIBUTE=samaccountname
LDAP_GUID_ATTRIBUTE=objectguid
LDAP_TLS=true
LDAP_STARTTLS=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
